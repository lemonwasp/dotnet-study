@*RazorでC#コードを実行するブロックで、HTMLではなくサーバーで実行されるコード*@
@{
    ViewBag.Title = "Vue Study";
}

@*Vueが管理するHTML領域*@
@*JavaScriptで.mountを実行すると、Vueがid="app"の要素を探して管理する*@
<div id="app">
    @*{{　}}はテキストを表示するための構文
        HTMLファイル自体が再レンダリングされることではなく、
        ブラウザで表示されるDOMが更新される
        Vueデータ変更→Vueが変更感知→DOM更新*@
    <h2>Messages</h2>

    <div>
        <input v-model="newMessage"
               type="text"
               placeholder="Enter a message" />

        <button type="button" v-on:click="addMessage">
            Add
        </button>
    </div>

    <p v-if="messages.length === 0">
        loading...
    </p>

    <ul v-else>
        <li v-for="message in messages" :key="message.Id">
            <template v-if="message.Id === editingId">
                <input v-model="editingMessage" type="text" />

                <button type="button" v-on:click="updateMessage">
                    Save
                </button>

                <button type="button" v-on:click="cancelEdit">
                    Cancel
                </button>
            </template>

            <template v-else>
                <strong>#{{ message.Id }}</strong>
                &nbsp;
                <span>{{ message.Message }}</span>
                &nbsp;
                <button type="button" v-on:click="startEdit(message)">
                    Edit
                </button>
                <button type="button" v-on:click="deleteMessage(message.Id)">
                    Delete
                </button>

                <br />
                <small>{{ formatDate(message.CreatedAt) }}</small>
            </template>
        </li>
    </ul>

    <div>
        <button type="button"
                v-on:click="previousPage"
                v-bind:disabled="page <= 1">
            Previous
        </button>

        <span>
            Page {{ totalPages === 0 ? 0 : page }} / {{ totalPages }}
            ({{ totalCount }} total)
        </span>

        <button type="button"
                v-on:click="nextPage"
                v-bind:disabled="page >= totalPages">
            Next
        </button>
    </div>

    @*<button type="button" v-on:click="count++">
            클릭 횟수 : {{ count }}
        </button>*@
</div>

@*共通レイアウト「_Layout.cshtml」を使用する場合、
@section scriptsを使用して該当位置にスクリプトを挿入することができる
_Layout.cshtmlの@RenderSection("scripts", required: false)の位置に挿入される。*@
@section scripts {
    @*Vueファイルをnpmでインストールしなく、CDNで読み込む場合は、以下のように記述する*@
    @*ブラウザに全域オブジェクトVueが生成されるため、
        Vue.createApp()でアプリケーションを作成することができる*@
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    @*～はアプリケーションのるーとディレクトリを指す*@
    <script src="@Url.Content("~/Scripts/pages/home-index.js")"></script>
}